{
  "expo": {
    "name": "Konura",
    "slug": "konura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon/web-app-manifest-512x512.png",
    "scheme": "vendors",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/favicon/apple-touch-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/favicon/web-app-manifest-512x512.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon/favicon-96x96.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#29B463",
          "android": {
            "image": "./assets/favicon/web-app-manifest-512x512.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
